# Copy to .env and fill in. .env is git-ignored: the key stays on this machine.
OPENAI_API_KEY=sk-put-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# How much detail of each picture the model gets: low is a fixed, small token
# cost and is enough to see floors, doorways and obstacles. high | auto cost more.
IMAGE_DETAIL=low

# For models that think before answering: none | minimal | low | medium | high.
# Leave empty for the model's own default. "none" keeps each step fast and cheap,
# which suits driving: the pictures do the work, not the reasoning.
REASONING_EFFORT=

# The robot's address. Options:
#   auto        look for it on this network at startup (works inside Docker too)
#   robo.local  its mDNS name (does not resolve inside most containers)
#   192.168.x.x the address it printed on the serial monitor
#   fake        no hardware at all: try the server on its own
# The robot never needs THIS machine's address: the server always calls the robot.
ROBOT_HOST=auto

# Picture size sent to the model: qqvga (160x120), qvga (320x240), vga (640x480)
PICTURE_SIZE=qvga

# Motor speed (80-255) and how the robot moves at full speed. Measure yours:
# drive forward 2 s and measure the distance; spin 2 s and count the turns.
DRIVE_SPEED=200
CM_PER_SEC=20
DEG_PER_SEC=180

# Prices per million tokens, for the cost estimate on the dashboard only.
# These are gpt-4.1-mini's; check what your account is actually charged.
PRICE_IN_PER_M=0.40
PRICE_CACHED_PER_M=0.10
PRICE_OUT_PER_M=1.60
